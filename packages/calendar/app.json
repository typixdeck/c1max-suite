{
  "schemaVersion": 1,
  "repository": "typixdeck/c1max-suite",
  "distribution": "complete-deb",
  "application": {
    "id": "ai.typixdeck.calendar",
    "package": "typix-calendar",
    "name": {
      "zh-CN": "日历",
      "en": "Typix Calendar"
    },
    "summary": {
      "zh-CN": "月历、本地日程、ICS 导入导出与订阅"
    },
    "description": {
      "zh-CN": "月历、本地日程、ICS 导入导出与订阅。完整原生 Linux 应用；保留用户自己的数据。硬件和服务依赖请见应用说明。"
    },
    "categories": [
      "Office"
    ],
    "desktopFile": "typix-calendar.desktop",
    "icon": "typix-calendar",
    "runtime": {
      "kind": "native",
      "path": "/usr/bin/typix-calendar"
    },
    "requiredPayload": [
      "/usr/bin/typix-calendar",
      "/usr/share/typix-calendar/shared/NotoSansSC-Regular.ttf"
    ],
    "compatibility": {
      "arch": [
        "arm64"
      ],
      "minMemoryMB": 128,
      "minFreeDiskMB": 64,
      "display": [
        "wayland",
        "x11"
      ],
      "requiredFeatures": []
    }
  },
  "release": {
    "version": "0.2.0-1",
    "file": "dist/typix-calendar_0.2.0-1_arm64.deb",
    "sha256": "950a7768e551e192905b01af2d1447b8701a9add521364afc20cfec4df66bf60"
  },
  "screenshots": [
    {
      "path": "docs/screenshots/calendar-0.2.0-arm64.png",
      "caption": "0.2.0 ARM64 deb 实际 GTK 界面，800×600，隔离 Trixie/Xvfb；未验证 CM4 实体触摸、音频及外部服务"
    }
  ]
}
