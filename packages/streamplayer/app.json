{
  "schemaVersion": 1,
  "repository": "typixdeck/c1max-suite",
  "distribution": "complete-deb",
  "application": {
    "id": "ai.typixdeck.streamplayer",
    "package": "typix-streamplayer",
    "name": {
      "zh-CN": "流媒体",
      "en": "Typix StreamPlayer"
    },
    "summary": {
      "zh-CN": "Emby/Jellyfin 登录、媒体库、服务端转码视频及字幕"
    },
    "description": {
      "zh-CN": "Emby/Jellyfin 登录、媒体库、服务端转码视频及字幕。完整原生 Linux 应用；保留用户自己的数据。硬件和服务依赖请见应用说明。"
