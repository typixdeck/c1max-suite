{
  "schemaVersion": 1,
  "repository": "typixdeck/c1max-suite",
  "distribution": "complete-deb",
  "application": {
    "id": "ai.typixdeck.hidpilot",
    "package": "typix-hidpilot",
    "name": {
      "zh-CN": "USB 键鼠",
      "en": "Typix HIDPilot"
    },
    "summary": {
      "zh-CN": "在已配置且有权限的 USB HID 节点上发送键鼠输入"
    },
    "description": {
      "zh-CN": "在已配置且有权限的 USB HID 节点上发送键鼠输入。完整原生 Linux 应用；保留用户自己的数据。硬件和服务依赖请见应用说明。"
    },
    "categories": [
      "Utility"
    ],
    "desktopFile": "typix-hidpilot.desktop",
    "runtime": {
      "kind": "python-script",
      "path": "/usr/share/typix-hidpilot/hidpilot.py"
    },
    "requiredPayload": [
