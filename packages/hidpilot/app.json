    ],
    "compatibility": {
      "arch": [
        "arm64"
      ],
      "minMemoryMB": 128,
      "minFreeDiskMB": 64,
      "display": [
        "wayland",
        "x11"
      ],
      "requiredFeatures": []
    }
  },
  "release": {
    "version": "0.1.0-1",
    "file": "dist/typix-hidpilot_0.1.0-1_all.deb",
    "sha256": "0f9d89a9d3f7f4d2cea784df8f0ccd8019d5ccfbabb30c2e4582162574d12d91"
  },
  "screenshots": [
