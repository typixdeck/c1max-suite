{
  "schemaVersion": 1,
  "repository": "typixdeck/c1max-suite",
  "distribution": "complete-deb",
  "application": {
    "id": "ai.typixdeck.ps1",
    "package": "typix-ps1",
    "name": {
      "zh-CN": "PS1 游戏库",
      "en": "Typix PS1 Library"
    },
    "summary": {
      "zh-CN": "PS1 光盘游戏库、BIOS 导入与 Mednafen 即时存档运行"
    },
    "description": {
      "zh-CN": "PS1 光盘游戏库、BIOS 导入与 Mednafen 即时存档运行。完整原生 Linux 应用；保留用户自己的数据。硬件和服务依赖请见应用说明。"
    },
    "categories": [
      "Game"
    ],
    "desktopFile": "typix-ps1.desktop",
    "runtime": {
      "kind": "python-script",
      "path": "/usr/share/typix-ps1/game_library.py"
    },
    "requiredPayload": [
      "/usr/bin/typix-ps1",
      "/usr/share/typix-ps1/game_library.py"
    ],
    "compatibility": {
      "arch": [
        "arm64"
      ],
      "minMemoryMB": 256,
      "minFreeDiskMB": 64,
      "display": [
        "wayland",
        "x11"
      ],
      "requiredFeatures": []
    }
  },
  "release": {
    "version": "0.1.0-1",
    "file": "dist/typix-ps1_0.1.0-1_all.deb",
    "sha256": "cf449267afb4235a439ec4fa2bdb54995d7e759674b06811086fcbca22253eb1"
  },
  "screenshots": [
    {
      "path": "docs/screenshots/ps1.png",
      "caption": "CM4 独立 800×600 测试会话中的实际界面"
    }
  ]
