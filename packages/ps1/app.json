    "requiredPayload": [
      "/usr/bin/typix-ps1",
      "/usr/share/typix-ps1/game_library.py"
    ],
    "compatibility": {
      "arch": [
        "arm64"
      ],
      "minMemoryMB": 256,
      "minFreeDiskMB": 64,
      "display": [
        "wayland",
        "x11"
      ],
      "requiredFeatures": []
    }
  },
  "release": {
    "version": "0.2.0-1",
    "file": "dist/typix-ps1_0.2.0-1_all.deb",
    "sha256": "3f26a072ae41120655f72ee18589ac9a9b7970aeffd5c9199a4315345440157e"
  },
  "screenshots": [
