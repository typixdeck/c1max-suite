{
  "schemaVersion": 1,
  "repository": "typixdeck/c1max-suite",
  "distribution": "complete-deb",
  "application": {
    "id": "ai.typixdeck.calculator",
    "package": "typix-calculator",
    "name": {
      "zh-CN": "计算器",
      "en": "Typix Calculator"
    },
    "summary": {
      "zh-CN": "四则、括号、乘方、历史与实体键盘计算"
    },
    "description": {
      "zh-CN": "四则、括号、乘方、历史与实体键盘计算。完整原生 Linux 应用；保留用户自己的数据。硬件和服务依赖请见应用说明。"
    },
    "categories": [
      "Utility"
    ],
    "desktopFile": "typix-calculator.desktop",
    "icon": "typix-calculator",
    "runtime": {
      "kind": "native",
      "path": "/usr/bin/typix-calculator"
    },
    "requiredPayload": [
      "/usr/bin/typix-calculator",
      "/usr/share/typix-calculator/shared/NotoSansSC-Regular.ttf"
    ],
    "compatibility": {
      "arch": [
        "arm64"
      ],
      "minMemoryMB": 128,
      "minFreeDiskMB": 64,
      "display": [
        "wayland",
        "x11"
      ],
      "requiredFeatures": []
    }
  },
  "release": {
    "version": "0.2.0-1",
    "file": "dist/typix-calculator_0.2.0-1_arm64.deb",
    "sha256": "7fdc9659972482066e52d6db6d21185dcc13a38d20b3e5499e0324bd8259a306"
  },
  "screenshots": [
    {
      "path": "docs/screenshots/calculator-0-2-0-arm64.png",
      "caption": "0.2.0 ARM64 deb 实际 GTK 界面，800×600，隔离 Trixie/Xvfb；未验证 CM4 实体触摸、音频及外部服务"
    }
  ]
}
