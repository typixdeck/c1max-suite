{
  "schemaVersion": 1,
  "repository": "typixdeck/c1max-suite",
  "distribution": "complete-deb",
  "application": {
    "id": "ai.typixdeck.mail",
    "package": "typix-mail",
    "name": {
      "zh-CN": "邮件",
      "en": "Typix Mail"
    },
    "summary": {
      "zh-CN": "POP3 收件与 SMTP TLS 纯文本邮件客户端"
    },
    "description": {
      "zh-CN": "POP3 收件与 SMTP TLS 纯文本邮件客户端。完整原生 Linux 应用；保留用户自己的数据。硬件和服务依赖请见应用说明。"
    },
    "categories": [
      "Network"
    ],
    "desktopFile": "typix-mail.desktop",
    "icon": "typix-mail",
    "runtime": {
      "kind": "native",
      "path": "/usr/bin/typix-mail"
    },
    "requiredPayload": [
      "/usr/bin/typix-mail",
      "/usr/share/typix-mail/shared/NotoSansSC-Regular.ttf"
    ],
    "compatibility": {
      "arch": [
        "arm64"
      ],
      "minMemoryMB": 128,
      "minFreeDiskMB": 64,
      "display": [
        "wayland",
        "x11"
      ],
      "requiredFeatures": []
    }
  },
  "release": {
    "version": "0.2.0-1",
    "file": "dist/typix-mail_0.2.0-1_arm64.deb",
    "sha256": "92bfc888f7e06822de5b831a856ad7614371e812383a36bceb90e2b42c2198a3"
  },
  "screenshots": [
    {
      "path": "docs/screenshots/mail-0.2.0-arm64.png",
      "caption": "0.2.0 ARM64 deb 实际 GTK 界面，800×600，隔离 Trixie/Xvfb；未验证 CM4 实体触摸、音频及外部服务"
    }
  ]
}
