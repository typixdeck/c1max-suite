      "/usr/share/typix-dosbox/game_library.py"
    ],
    "compatibility": {
      "arch": [
        "arm64"
      ],
      "minMemoryMB": 256,
      "minFreeDiskMB": 64,
      "display": [
        "wayland",
        "x11"
      ],
      "requiredFeatures": []
    }
  },
  "release": {
    "version": "0.2.0-1",
    "file": "dist/typix-dosbox_0.2.0-1_all.deb",
    "sha256": "3a62f1045f66dae0ec4a23318e9a37244b40753fded98b2be9eba0daeb732274"
  },
  "screenshots": [
    {
