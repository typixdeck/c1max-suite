{
  "schemaVersion": 1,
  "repository": "typixdeck/c1max-suite",
  "distribution": "complete-deb",
  "application": {
    "id": "ai.typixdeck.dosbox",
    "package": "typix-dosbox",
    "name": {
      "zh-CN": "DOS 游戏库",
      "en": "Typix DOSBox"
    },
    "summary": {
      "zh-CN": "本地 DOS 游戏目录、完整 DOSBox 运行与会话管理"
    },
    "description": {
      "zh-CN": "本地 DOS 游戏目录、完整 DOSBox 运行与会话管理。完整原生 Linux 应用；保留用户自己的数据。硬件和服务依赖请见应用说明。"
    },
    "categories": [
      "Game"
    ],
    "desktopFile": "typix-dosbox.desktop",
    "icon": "typix-dosbox",
    "runtime": {
      "kind": "python-script",
      "path": "/usr/share/typix-dosbox/game_library.py"
    },
    "requiredPayload": [
