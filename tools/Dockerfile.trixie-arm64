FROM debian:trixie-slim

# Isolated Linux ARM64 build and GUI test environment. Never modifies a Pi.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config libgtk-3-dev dpkg-dev python3 \
    python3-gi python3-gi-cairo python3-pil xvfb wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
